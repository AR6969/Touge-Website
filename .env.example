# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# Required for the map. A PUBLIC Mapbox token, starting with "pk.".
# Create one at https://account.mapbox.com/access-tokens/ and restrict it to
# your domain. Never put a secret token (sk.) in a NEXT_PUBLIC_ variable — they
# are compiled into the browser bundle and are visible to anyone.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here

# The deployed site's absolute origin, no trailing slash.
# Canonical tags, sitemap.xml, robots.txt and social-card URLs are built from it.
# Leave unset for local development (falls back to http://localhost:3000).
# On Vercel without a custom domain, leave it unset: the project's production
# URL is used automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public Formspree form endpoint used by /contact. This does not expose your email.
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
